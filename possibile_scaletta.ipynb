    "# Define the tumor type to analyze\n",
    "TUMOR_TYPE = 'ESAD' \n",
    "\n",
    "# Select the cohort: filter rows for the chosen tumor type\n",
    "df_1 = df[df['ttype'] == TUMOR_TYPE].copy()\n",
    "\n",
    "# Clean temporal data: remove rows where 'clock_mean', 'clock_rank', or 'gene' are missing\n",
    "df_1 = df_1.dropna(subset=['clock_mean', 'clock_rank', 'gene'])\n",
    "\n",
    "# --- FIND DRIVER GENES DYNAMICALLY ---\n",
    "# # Since we don't know the drivers, we select the top N most frequent genes in this tumor\n",
    "# TOP_N_GENES = 15\n",
    "# top_frequent_genes = df_1['gene'].value_counts().head(TOP_N_GENES).index.tolist()\n",
    "# print(f\"Using the top {TOP_N_GENES} most frequent genes as drivers:\\n{top_frequent_genes}\")\n",
    "\n",
    "# # Filter the dataset keeping only these top genes\n",
    "# df_1 = df_1[df_1['gene'].isin(top_frequent_genes)]\n",
    "\n",
    "# Calculate average (clock_mean) and freq for each gene\n",
    "gene_clock_stats = df_1.groupby('gene')['clock_mean'].agg(['mean', 'count'])\n",
    "\n",
    "# Maintain mutated genes in at least N patients\n",
    "MIN_PATIENTS = 10\n",
    "valid_genes = gene_clock_stats[gene_clock_stats['count'] >= MIN_PATIENTS].copy()\n",
    "\n",
    "# Order the genes \n",
    "valid_genes = valid_genes.sort_values(by='mean')\n",
    "\n",
    "# Select the extrema: 10 higher/10 slowest\n",
    "early_genes = valid_genes.head(10).index.tolist()\n",
    "late_genes = valid_genes.tail(10).index.tolist()\n",
    "\n",
    "# Create the mixed list\n",
    "target_genes = list(set(early_genes + late_genes))\n",
    "print(f\"Clonal genes: {early_genes}\")\n",
    "print(f\"Subclonal genes: {late_genes}\")\n",
    "\n",
    "# Filter the dataset\n",
    "df_1 = df_1[df_1['gene'].isin(target_genes)]"
   ]
